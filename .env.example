# ===========================================
# WapiBei Backend — Environment Variables
# ===========================================

NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/wapobei

# JWT
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_SECRET=change-me

# Frontend origins allowed by CORS
# Local:
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Production example:
# FRONTEND_URL=https://your-frontend-domain.com

# SMS provider
# Use "mock" locally. Use "africastalking" for RDC/Africa, or "twilio" where supported.
SMS_PROVIDER=mock

# Africa's Talking SMS
# Sandbox: username is "sandbox" and sandbox=true.
# Production: use your real app username and sandbox=false.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=atsk_7a1fcbea2f1aa67506ffc83bddd07850a5301c09d3956f73e2ceea219eb2624723c3ba18
AFRICASTALKING_FROM=
AFRICASTALKING_SANDBOX=true
AFRICASTALKING_TIMEOUT_MS=10000

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use either TWILIO_FROM_NUMBER or TWILIO_MESSAGING_SERVICE_SID.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_TIMEOUT_MS=10000
