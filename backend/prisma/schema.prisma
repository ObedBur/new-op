generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  password            String
  fullName            String
  phone               String         @unique
  province            String
  commune             String
  address             String?
  role                UserRole       @default(CLIENT)
  boutiqueName        String?
  isVerified          Boolean        @default(false)
  otpHash             String?
  otpExpiresAt        DateTime?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  kycStatus           KycStatus      @default(NOT_REQUIRED)
  kycSubmittedAt      DateTime?
  kycApprovedAt       DateTime?
  kycRejectedAt       DateTime?
  kycRejectionReason  String?
  trustScore          Int            @default(50)
  dailyPublications   Int            @default(0)
  lastPublicationDate DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  otpAttempts         Int            @default(0)
  city                String?
  country             String         @default("RD Congo")
  avatarUrl           String?
  coverUrl            String?
  isActive            Boolean        @default(true)
  notifications       Notification[]
  cartItems           CartItem[]
  orders              Order[]        @relation("ClientOrders")
  sales               Order[]        @relation("VendorOrders")
  products            Product[]
  refreshTokens       RefreshToken[]
  follows             Follow[]       @relation("UserFollows")
  followers           Follow[]       @relation("UserFollowers")
  pushSubscriptions   PushSubscription[]
  notificationPreference NotificationPreference?
  addresses           Address[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([kycStatus])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Category {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  icon       String?
  colorClass String?
  bgClass    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  products   Product[]
}

model Product {
  id            String              @id @default(uuid())
  name          String
  description   String?
  nameFr        String?
  nameEn        String?
  nameSw        String?
  descriptionFr String?
  descriptionEn String?
  descriptionSw String?
  price         Float
  originalPrice Float?
  isOnSale      Boolean             @default(false)
  totalSales    Int                 @default(0)
  displayPrice  String?
  location      String?
  image         String?
  availability  ProductAvailability @default(IN_STOCK)
  market        Market?
  categoryId    Int
  userId        String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  city          String              @default("Goma")
  country       String              @default("RD Congo")
  images        String[]            @default([])
  isPublic      Boolean             @default(true)
  stockQuantity Int?
  unit          String?             @default("Pièce")
  orders        Order[]
  cartItems     CartItem[]
  category      Category            @relation(fields: [categoryId], references: [id])
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([userId])
  @@index([market])
  @@index([isOnSale])
  @@index([totalSales])
  @@index([isPublic, createdAt])
  @@index([isOnSale, isPublic, createdAt])
  @@index([isPublic, totalSales])
  @@index([categoryId, isPublic, createdAt])
}

model HeroSlide {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  label     String?
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HowItWorksStep {
  id          String   @id @default(cuid())
  icon        String
  title       String
  description String
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id              String      @id @default(uuid())
  customerName    String
  customerPhone   String
  customerEmail   String
  deliveryAddress String
  productId       String
  clientId        String
  vendorId        String
  status          OrderStatus @default(PENDING)
  totalPrice      Float
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  client          User        @relation("ClientOrders", fields: [clientId], references: [id])
  product         Product     @relation(fields: [productId], references: [id])
  vendor          User        @relation("VendorOrders", fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([clientId])
  @@index([status])
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  version   Int      @default(0)  // Optimistic locking — détecte les conflits multi-appareils
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, updatedAt(sort: Desc)])  // Index composé → couvre findForUser + orderBy updatedAt
  @@index([productId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM_ALERT)
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum UserRole {
  CLIENT
  VENDOR
  ADMIN
}

enum KycStatus {
  NOT_REQUIRED
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ProductAvailability {
  IN_STOCK
  LIMITED_STOCK
  OUT_OF_STOCK
}

enum Market {
  VIRUNGA
  BIRERE
  CENTRE_VILLE
  HIMBI
  KATINDO
  KINSHASA
  LUBUMBASHI
  BUKAVU
  KISANGANI
  KIGALI
  NAIROBI
  KAMPALA
  DAR_ES_SALAAM
  AUTRE
}

enum NotificationType {
  ORDER_CREATED
  ORDER_CONFIRMED
  PAYMENT_RECEIVED
  SYSTEM_ALERT
  NEW_PRODUCT
  PROMOTION
}

model Follow {
  id        String   @id @default(uuid())
  followerId String
  vendorId   String
  createdAt  DateTime @default(now())

  follower  User @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  vendor    User @relation("UserFollowers", fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([followerId, vendorId])
  @@index([followerId])
  @@index([vendorId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id           String  @id @default(uuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Commandes & Ventes
  ordersPush   Boolean @default(true)
  ordersEmail  Boolean @default(true)
  ordersInApp  Boolean @default(true)
  ordersSms    Boolean @default(false)

  // Vendeurs Favoris
  followsPush  Boolean @default(true)
  followsEmail Boolean @default(false)
  followsInApp Boolean @default(true)
  followsSms   Boolean @default(false)

  // Offres & Promotions
  promosPush   Boolean @default(true)
  promosEmail  Boolean @default(false)
  promosSms    Boolean @default(false)

  // Sécurité & Compte (toujours actif — stocké pour cohérence)
  securityEmail Boolean @default(true)
  securityInApp Boolean @default(true)

  updatedAt DateTime @updatedAt
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  title       String   // e.g., "Maison", "Bureau"
  street      String
  commune     String
  city        String
  province    String
  country     String   @default("RD Congo")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
