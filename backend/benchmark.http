# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🏓 PING — Health Check via route publique (< 400ms)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
### [1] Health Check — GET /api/categories
# @name ping
GET {{baseUrl}}/categories

###

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔒 AUTH — Routes d'authentification
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

### [2] LOGIN — POST /auth/login (devrait être < 500ms)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###

# La réponse du login retourne access_token (pas data.accessToken)
@accessToken = {{login.response.body.access_token}}

### [3] GET PROFIL — GET /auth/profile (devrait être < 300ms)
# @name profile
GET {{baseUrl}}/auth/profile
Authorization: Bearer {{accessToken}}

###

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📦 PRODUITS — Routes publiques (sans token)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

### [4] LISTE PRODUITS — GET /products (devrait être < 500ms)
GET {{baseUrl}}/products

###

### [4b] MES PRODUITS VENDEUR — GET /products/my-products (token requis)
GET {{baseUrl}}/products/my-products
Authorization: Bearer {{accessToken}}

###

### [5] PRODUITS DEALS — GET /products/deals
GET {{baseUrl}}/products/deals

###

### [6] NOUVELLES ARRIVÉES — GET /products/new-arrivals
GET {{baseUrl}}/products/new-arrivals

###

### [7] MEILLEURES VENTES — GET /products/best-sellers
GET {{baseUrl}}/products/best-sellers

###

### [8] RECOMMANDATIONS — GET /products/recommendations
GET {{baseUrl}}/products/recommendations
Authorization: Bearer {{accessToken}}

