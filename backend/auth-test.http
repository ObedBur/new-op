### ============================================================
### TEST AUTH - OBED BURINDI (Production Render)
### ============================================================
@baseUrl = https://new-op-y5fc.onrender.com/api 
@email = obedburindi@gmail.com     

### ------------------------------------------------------------
### 1. REGISTER (Inscription)
### ------------------------------------------------------------
# @name register
POST {{baseUrl}}/auth/register 
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "Password123!",
  "fullName": "Obed Burindi",
  "phone": "+243999999999",
  "province": "Nord-Kivu",
  "commune": "Goma",
  "role": "CLIENT"
}

### ------------------------------------------------------------
### 2. VERIFY OTP (Validation)
### Remplacez "123456" par le code reçu par email
### ------------------------------------------------------------
# @name verifyOtp
POST {{baseUrl}}/auth/verify-otp
Content-Type: application/json

{
  "email": "{{email}}",
  "otp": "807469" 
}

### ------------------------------------------------------------
### 3. RESEND OTP (Si besoin)
### ------------------------------------------------------------
POST {{baseUrl}}/auth/resend-otp
Content-Type: application/json

{
  "email": "{{email}}"
}

### ------------------------------------------------------------
### 4. LOGIN (Connexion)
### ------------------------------------------------------------
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "Password123!"
}

### ------------------------------------------------------------
### 5. GET ME (Vérifier le profil connecté)
### ------------------------------------------------------------
@accessToken = {{login.response.body.tokens.accessToken}}

GET {{baseUrl}}/auth/profile
Authorization: Bearer {{accessToken}}
