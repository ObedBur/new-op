generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  password            String
  fullName            String
  phone               String         @unique
  province            String         @default("")
  commune             String         @default("")
  address             String?
  quartier            String?
  role                Role           @default(CLIENT)
  boutiqueName        String?
  isVerified          Boolean        @default(false)
  otpHash             String?
  otpExpiresAt        DateTime?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  kycStatus           KycStatus      @default(NOT_REQUIRED)
  kycSubmittedAt      DateTime?
  kycApprovedAt       DateTime?
  kycRejectedAt       DateTime?
  kycRejectionReason  String?
  trustScore          Int            @default(50)
  dailyPublications   Int            @default(0)
  lastPublicationDate DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  otpAttempts         Int            @default(0)
  city                String?
  country             String         @default("RD Congo")
  avatarUrl           String?
  coverUrl            String?
  isActive            Boolean        @default(true)
  isPremium           Boolean        @default(false)
  metier              String?
  experience          String?
  bio                 String?
  status              Status         @default(DISPONIBLE)

  // Relations
  notifications        Notification[]
  orders               Order[]        @relation("ClientOrders")
  sales                Order[]        @relation("VendorOrders")
  products             Product[]
  refreshTokens        RefreshToken[]
  follows              Follow[]       @relation("UserFollows")
  followers            Follow[]       @relation("UserFollowers")
  pushSubscriptions    PushSubscription[]
  providerApplications ProviderApplication[]
  clientRequests       Request[]      @relation("ClientRequests")
  providerRequests     Request[]      @relation("ProviderRequests")
  payments             Payment[]
  services             Service[]      @relation("UserServices")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([kycStatus])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Category {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  icon       String?
  colorClass String?
  bgClass    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  products   Product[]
}

model Product {
  id            String              @id @default(uuid())
  name          String
  description   String?
  price         Float
  originalPrice Float?
  isOnSale      Boolean             @default(false)
  totalSales    Int                 @default(0)
  displayPrice  String?
  location      String?
  image         String?
  availability  ProductAvailability @default(IN_STOCK)
  market        Market?
  categoryId    Int
  userId        String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  city          String              @default("Goma")
  country       String              @default("RD Congo")
  images        String[]            @default([])
  isPublic      Boolean             @default(true)
  stockQuantity Int?                @default(0)
  unit          String?             @default("Pièce")
  orders        Order[]
  category      Category            @relation(fields: [categoryId], references: [id])
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([userId])
  @@index([market])
  @@index([isOnSale])
  @@index([totalSales])
  @@index([isPublic, createdAt])
  @@index([isOnSale, isPublic, createdAt])
  @@index([isPublic, totalSales])
  @@index([categoryId, isPublic, createdAt])
}

model HeroSlide {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  label     String?
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HowItWorksStep {
  id          String   @id @default(cuid())
  icon        String
  title       String
  description String
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id              String      @id @default(uuid())
  customerName    String
  customerPhone   String
  customerEmail   String
  deliveryAddress String
  productId       String
  clientId        String
  vendorId        String
  status          OrderStatus @default(PENDING)
  totalPrice      Float
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  client          User        @relation("ClientOrders", fields: [clientId], references: [id])
  product         Product     @relation(fields: [productId], references: [id])
  vendor          User        @relation("VendorOrders", fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([clientId])
  @@index([status])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM_ALERT)
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── SERVICE CATALOGUE (Kaskade Services) ────────────────────────────────────

model Service {
  id                String    @id @default(uuid())
  name              String
  category          String
  description       String?
  price             Float     @default(0)
  currency          String    @default("USD")
  isActive          Boolean   @default(true)
  imageKey          String?
  workingHoursStart String    @default("06:00")
  workingHoursEnd   String    @default("18:00")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  requests  Request[]
  providers User[]    @relation("UserServices")

  @@index([category])
  @@index([isActive])
}

// ─── SERVICE REQUEST (Demande de service client) ─────────────────────────────

model Request {
  id                String        @id @default(uuid())
  serviceId         String
  clientId          String
  providerId        String?
  description       String?
  address           String?
  scheduledAt       DateTime?
  scheduleTime      String?
  scheduleFrequency String?
  scheduleDay       String?
  price             Float?
  status            RequestStatus @default(PENDING)
  acceptedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  service  Service   @relation(fields: [serviceId], references: [id])
  client   User      @relation("ClientRequests", fields: [clientId], references: [id])
  provider User?     @relation("ProviderRequests", fields: [providerId], references: [id])
  payments Payment[]

  @@index([serviceId])
  @@index([clientId])
  @@index([providerId])
  @@index([status])
}

// ─── PROVIDER APPLICATION (Candidature prestataire) ──────────────────────────

model ProviderApplication {
  id         String        @id @default(uuid())
  userId     String
  motivation String
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ─── PAYMENT (Paiements Mobile Money) ────────────────────────────────────────

model Payment {
  id          String   @id @default(uuid())
  requestId   String
  clientId    String
  amount      Float
  currency    String   @default("USD")
  operator    String
  phoneNumber String
  type        String   // DEPOSIT | FINAL
  status      String   @default("PENDING") // PENDING | SUCCESS | FAILED
  mbiyoRef    String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [id])
  client  User    @relation(fields: [clientId], references: [id])

  @@index([requestId])
  @@index([clientId])
  @@index([status])
}

model Follow {
  id         String   @id @default(uuid())
  followerId String
  vendorId   String
  createdAt  DateTime @default(now())

  follower User @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  vendor   User @relation("UserFollowers", fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([followerId, vendorId])
  @@index([followerId])
  @@index([vendorId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum Role {
  CLIENT
  VENDOR
  ADMIN
  PROVIDER
}

enum KycStatus {
  NOT_REQUIRED
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ProductAvailability {
  IN_STOCK
  LIMITED_STOCK
  OUT_OF_STOCK
}

enum Market {
  VIRUNGA
  BIRERE
  CENTRE_VILLE
  HIMBI
  KATINDO
  KINSHASA
  LUBUMBASHI
  BUKAVU
  KISANGANI
  KIGALI
  NAIROBI
  KAMPALA
  DAR_ES_SALAAM
  AUTRE
}

enum NotificationType {
  ORDER_CREATED
  ORDER_CONFIRMED
  PAYMENT_RECEIVED
  SYSTEM_ALERT
  NEW_PRODUCT
  PROMOTION
}

enum RequestStatus {
  PENDING
  APPROVED
  ACCEPTED
  IN_PROGRESS
  AWAITING_FINAL
  COMPLETED
  REJECTED
}

enum Status {
  DISPONIBLE
  EN_MISSION
}
